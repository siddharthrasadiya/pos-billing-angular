    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@types/web-bluetooth": "^0.0.22",
    "angular-cli-ghpages": "^3.1.2",
    "node": "^22.23.4",
    "npm": "^11.21.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "allowScripts": {
    "node@22.23.4": true
  }
